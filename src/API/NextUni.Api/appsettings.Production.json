{
  "ConnectionStrings": {
    "Database": "Host=nextuni.database;Port=5432;Database=nextuni;Username=postgres;Password=postgres;Include Error Detail=true",
    "Cache": "nextuni.redis:6379"
  },
  "Authentication": {
    "Audience": "account",
    "TokenValidationParameters": {
      "ValidIssuers": [ "http://nextuni.identity:8080/realms/nextuni", "http://localhost:18080/realms/nextuni" ]
    },
    "MetadataAddress": "http://nextuni.identity:8080/realms/nextuni/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "KeyCloak": {
    "HealthUrl": "http://nextuni.identity:8080/health/"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://nextuni.seq:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "NextUni.Api"
    }
  }
}